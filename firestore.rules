rules_version = '2';
// Sureler Oyun Bahcesi - Firestore guvenlik kurallari
// Firebase konsolu > Firestore Database > Rules sekmesine oldugu gibi yapistirin.
service cloud.firestore {
  match /databases/{database}/documents {
    function girisli() { return request.auth != null; }
    function ben(uid) { return girisli() && request.auth.uid == uid; }
    function yeni() { return request.resource.data; }

    // Kisisel ilerleme ve profiller: yalniz sahibi okur/yazar; belge adlari sinirli
    match /data/users/{uid}/{belge} {
      allow read: if ben(uid);
      allow write: if ben(uid) && belge.matches('profiller|fatiha(-[A-Za-z0-9_]{1,24})?');
    }

    // Ortak hedefler: herkes gorur, herkes yeni hedef koyabilir; konan hedef degistirilemez
    match /hedef/{kod} {
      allow get: if girisli();
      allow create: if girisli() && kod.matches('[A-Z0-9]{8}')
                    && yeni().keys().hasOnly(['ad', 'hedef', 'tur', 't'])
                    && yeni().ad is string && yeni().ad.size() > 0 && yeni().ad.size() <= 40
                    && yeni().hedef is int && yeni().hedef >= 10 && yeni().hedef <= 10000
                    && yeni().tur in ['tekrar', 'soru']
                    && yeni().t is string && yeni().t.size() <= 10;
      // Katki: herkes yalniz kendi u_<kimlik> alanini (0-100000 arasi tam sayi) degistirebilir; liste okunamaz
      allow update: if girisli()
                    && yeni().diff(resource.data).affectedKeys().hasOnly(['u_' + request.auth.uid])
                    && yeni()['u_' + request.auth.uid] is int
                    && yeni()['u_' + request.auth.uid] >= 0 && yeni()['u_' + request.auth.uid] <= 100000
                    // bir yazmada en cok 1000 artis (tek seferde hedefi bitirme hilesine karsi)
                    && yeni()['u_' + request.auth.uid] <= resource.data.get('u_' + request.auth.uid, 0) + 1000
                    && resource.data.keys().size() < 500;
    }

    // Kullanim sayaci: herkes yalniz kendininkini yazar; okumak yalniz konsoldan
    match /kullanim/{uid} {
      allow delete: if ben(uid);
      allow create, update: if ben(uid) && yeni().keys().hasOnly(['g', 's'])
                    && yeni().g is map && yeni().g.size() <= 92
                    && yeni().s is string && yeni().s.size() <= 12;
    }

    // Aile yarismasi canli odalari
    // Odaya ilk yayin yapan sahip olur; sahip her nabizda zamani tazeler, 3 saat sessiz kalan odayi baskasi devralabilir
    // Oda adi: yaris- + 8 harf/rakam (tahmin edilemeyen kod)
    function odaAdi(oda) { return oda.matches('yaris-[A-Z2-9]{8}'); }
    // son: TTL politikasinin silme zamani; zorunlu, gelecekte ve en cok 8 gun sonrasi (gonderilmezse belge hic silinmezdi)
    function sonIyi() { return 'son' in yeni() && yeni().son is timestamp
                          && yeni().son > request.time && yeni().son < request.time + duration.value(8, 'd'); }
    match /odalar/{oda} {
      allow get: if girisli();
      allow create: if girisli() && odaAdi(oda) && yeni().keys().hasOnly(['sahip', 't', 'son']) && sonIyi()
                    && yeni().sahip == request.auth.uid && yeni().t == request.time;
      allow update: if girisli() && odaAdi(oda) && yeni().keys().hasOnly(['sahip', 't', 'son']) && sonIyi()
                    && yeni().sahip == request.auth.uid && yeni().t == request.time
                    && (resource.data.sahip == request.auth.uid || resource.data.t < request.time - duration.value(3, 'h'));
    }
    match /odalar/{oda}/esler/{uid} {
      allow read: if girisli() && odaAdi(oda);
      // Oyuncu kaydi: yalniz ad (en cok 20 harf) ve secilen cevap; ilk kayit yalniz var olan odaya (uydurma odalara yazilmasin)
      allow create: if oyuncuIyi(uid, oda) && exists(/databases/$(database)/documents/odalar/$(oda));
      allow update: if oyuncuIyi(uid, oda);
      allow delete: if ben(uid);
    }
    function oyuncuIyi(uid, oda) {
      return ben(uid) && odaAdi(oda) && yeni().keys().hasOnly(['presence', 't', 'son']) && sonIyi() && yeni().t == request.time
                    && yeni().presence is map && yeni().presence.keys().hasOnly(['ad', 'c'])
                    && (!('ad' in yeni().presence) || (yeni().presence.ad is string && yeni().presence.ad.size() <= 20))
                    && (!('c' in yeni().presence) || (yeni().presence.c is map && yeni().presence.c.keys().hasOnly(['q', 'j'])
                         && yeni().presence.c.q is int && yeni().presence.c.j is int && yeni().presence.c.j >= 0 && yeni().presence.c.j < 8));
    }
    match /odalar/{oda}/olaylar/{olay} {
      allow read: if girisli() && odaAdi(oda);
      // Yalniz "durum" olayi; ilk yazimda oda sahipligi denetlenir (1 okuma), sonraki yazimlarda yalniz ilk yazan degistirebilir (okuma yok)
      allow create: if olayIyi(oda, olay)
                    && get(/databases/$(database)/documents/odalar/$(oda)).data.sahip == request.auth.uid;
      allow update: if olayIyi(oda, olay) && resource.data.kimden == request.auth.uid;
      allow delete: if girisli() && resource.data.kimden == request.auth.uid;
    }
    function olayIyi(oda, olay) {
      return girisli() && odaAdi(oda) && olay == 'durum'
        && yeni().keys().hasOnly(['data', 'kimden', 't', 'son']) && sonIyi()
        && yeni().kimden == request.auth.uid && yeni().t == request.time
        && yeni().data is map && yeni().data.size() <= 20
        && (!('kel' in yeni().data) || (yeni().data.kel is list && yeni().data.kel.size() <= 60))
        && (!('opts' in yeni().data) || (yeni().data.opts is list && yeni().data.opts.size() <= 8))
        && (!('skor' in yeni().data) || (yeni().data.skor is list && yeni().data.skor.size() <= 60))
        && (!('sure' in yeni().data) || (yeni().data.sure is string && yeni().data.sure.size() <= 60));
    }

    // Aile kodu: ayni ailenin cihazlari kayitlari ortak yoldan esitler
    // Kod 10 harf/rakam (tahmin edilemez); kodu bilen kisi yalniz kendini uyelere ekleyebilir (en cok 8 uye)
    function aileKod(kod) { return kod.matches('[A-Z2-9]{10}'); }
    function aileUyesi(kod) {
      return girisli() && request.auth.uid in get(/databases/$(database)/documents/aileler/$(kod)).data.uyeler;
    }
    match /aileler/{kod} {
      allow get: if girisli() && request.auth.uid in resource.data.uyeler;
      allow create: if girisli() && aileKod(kod) && yeni().keys().hasOnly(['sahip', 'uyeler', 't'])
                    && yeni().sahip == request.auth.uid && yeni().uyeler == [request.auth.uid]
                    && yeni().t is string && yeni().t.size() <= 10;
      // sahip uye cikarirken cikanlari 'yasak' listesine yazar (en cok 50); baskasi yasak listesine dokunamaz
      allow update: if girisli() && yeni().uyeler is list
                    && (yeni().diff(resource.data).affectedKeys().hasOnly(['uyeler'])
                        || (resource.data.sahip == request.auth.uid && yeni().diff(resource.data).affectedKeys().hasOnly(['uyeler', 'yasak'])
                            && yeni().yasak is list && yeni().yasak.size() <= 50 && !(request.auth.uid in yeni().yasak)))
                    && (
                      // (i) uye olmayan (ve sahibin cikardiklari arasinda olmayan) yalniz kendini sona ekler
                      (!(request.auth.uid in resource.data.uyeler) && !(request.auth.uid in resource.data.get('yasak', []))
                        && yeni().uyeler == resource.data.uyeler.concat([request.auth.uid]) && yeni().uyeler.size() <= 8)
                      // (ii) sahip uyeleri cikarabilir (kendisi listede kalir)
                      || (resource.data.sahip == request.auth.uid && resource.data.uyeler.hasAll(yeni().uyeler)
                        && request.auth.uid in yeni().uyeler)
                      // (iii) sahip olmayan uye kendini cikarabilir
                      || (request.auth.uid in resource.data.uyeler && resource.data.sahip != request.auth.uid
                        && yeni().uyeler == resource.data.uyeler.removeAll([request.auth.uid]))
                    );
      allow delete: if girisli() && resource.data.sahip == request.auth.uid;
    }
    match /aileler/{kod}/kayit/{belge} {
      allow read, write: if aileKod(kod) && aileUyesi(kod) && belge.matches('profiller|fatiha(-[A-Za-z0-9_]{1,24})?');
    }

    // Ogretmen paneli: sinif belgesi herkese okunur (ogrenci katilirken sinif adini gorur); yalniz ogretmen degistirir
    function sinifKod(kod) { return kod.matches('[A-Z2-9]{8}'); }
    function sinifOgretmeni(kod) {
      return girisli() && get(/databases/$(database)/documents/siniflar/$(kod)).data.ogretmen == request.auth.uid;
    }
    function odevIyi() {
      return yeni().odev == null || (yeni().odev is map && yeni().odev.keys().hasOnly(['sure', 'tur', 'son'])
        && yeni().odev.sure is int && yeni().odev.sure >= 1 && yeni().odev.sure <= 999999
        && yeni().odev.tur in ['ezber', 'yildiz'] && yeni().odev.son is string && yeni().odev.son.size() <= 10);
    }
    function sinifIyi() {
      return yeni().keys().hasOnly(['ogretmen', 'ad', 'odev', 't'])
        && yeni().ad is string && yeni().ad.size() > 0 && yeni().ad.size() <= 40
        && yeni().t is string && yeni().t.size() <= 10 && odevIyi();
    }
    match /siniflar/{kod} {
      allow get: if girisli();
      allow create: if girisli() && sinifKod(kod) && sinifIyi() && yeni().ogretmen == request.auth.uid;
      allow update: if girisli() && resource.data.ogretmen == request.auth.uid && sinifIyi()
                    && yeni().ogretmen == resource.data.ogretmen;
      allow delete: if girisli() && resource.data.ogretmen == request.auth.uid;
    }
    // Ogrenci belgesi: kimlik ya da kimlik_<kisi> (ayni cihazda birden cok cocuk); yalniz takma ad ve ozet sayilar
    function benimOgrenci(uid) {
      return girisli() && (uid == request.auth.uid || uid.matches(request.auth.uid + '_[A-Za-z0-9_]{1,24}'));
    }
    match /siniflar/{kod}/ogrenciler/{uid} {
      allow get: if benimOgrenci(uid) || sinifOgretmeni(kod);
      allow list: if sinifOgretmeni(kod);
      allow create, update: if benimOgrenci(uid) && sinifKod(kod)
                    && exists(/databases/$(database)/documents/siniflar/$(kod))
                    && yeni().keys().hasOnly(['ad', 'ozet', 't'])
                    && yeni().ad is string && yeni().ad.size() > 0 && yeni().ad.size() <= 20
                    && yeni().t is string && yeni().t.size() <= 10
                    && yeni().ozet is map && yeni().ozet.keys().hasOnly(['ezberde', 'yildiz', 'sonGun', 'odevDurum'])
                    && yeni().ozet.ezberde is int && yeni().ozet.ezberde >= 0 && yeni().ozet.ezberde <= 10000
                    && yeni().ozet.yildiz is int && yeni().ozet.yildiz >= 0 && yeni().ozet.yildiz <= 10000
                    && yeni().ozet.sonGun is string && yeni().ozet.sonGun.size() <= 10
                    && yeni().ozet.odevDurum in ['yok', 'suruyor', 'tamam', 'gecikti'];
      // ogrenci kendini cikarir; ogretmen sinifi silerken ogrenci kayitlarini da siler
      allow delete: if benimOgrenci(uid) || sinifOgretmeni(kod);
    }
  }
}
