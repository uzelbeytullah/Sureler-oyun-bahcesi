261.555]},{"ok":"irke‘û","tr":"rükû edin","alan":"a9","a":"ٱرْكَعُوا۟","k":["077",261.555,262.345]},{"ok":"lâ","tr":"değil","alan":"a10","a":"لَا","k":["077",262.345,262.725]},{"ok":"yerke‘ûne","tr":"rükû ederler","alan":"a9","a":"يَرْكَعُونَ","k":["077",262.725,265.94]}],"ar":["وَإِذَا","قِيلَ","لَهُمُ","ٱرْكَعُوا۟","لَا","يَرْكَعُونَ"]},{"ok":"Veylün yevme’izin li’l-mükezzibîn","sira":"Yazıklar olsun o gün yalanlayanlara.","meal":"O gün yalan diyenlerin vay hâline.","oz":"Nakarat","w":[{"ok":"veylün","tr":"veyl (yazıklar olsun )","alan":"a5","a":"وَيْلٌ","k":["077",266.035,267.805]},{"ok":"yevme’izin","tr":"o gün","alan":"a2","a":"يَوْمَئِذٍۢ","k":["077",267.805,268.675]},{"ok":"li’l-mükezzibîn","tr":"yalanlayanlara","alan":"a5","a":"لِّلْمُكَذِّبِينَ","k":["077",268.675,272.74]}],"ar":["وَيْلٌ","يَوْمَئِذٍۢ","لِّلْمُكَذِّبِينَ"]},{"ok":"Fe bi eyyi hadîsin ba‘dehû yü’minûn","sira":"Peki ondan sonra hangi söze inanırlar?","meal":"Artık bundan sonra hangi söze inanacaklar?","oz":"Söz","w":[{"ok":"fe bi eyyi","tr":"peki hangi","alan":"a10","a":"فَبِأَىِّ","k":["077",272.855,273.905]},{"ok":"hadîsin","tr":"söz (haber)","alan":"a8","a":"حَدِيثٍ","k":["077",273.905,275.045]},{"ok":"ba‘dehû","tr":"ondan sonra","alan":"a10","a":"بَعْدَهُۥ","k":["077",275.045,276.805]},{"ok":"yü’minûne","tr":"inanırlar","alan":"a9","a":"يُؤْمِنُونَ","k":["077",276.805,282.37]}],"ar":["فَبِأَىِّ","حَدِيثٍ","بَعْدَهُۥ","يُؤْمِنُونَ"]}],"bilgi":[{"q":"Mürselât Mushaf’ta kaçıncı suredir?","a":"77","o":["76","77","78","79"]},{"q":"Mürselât suresi kaç ayettir?","a":"50","o":["40","46","50","56"]},{"q":"Mürselât suresi nerede inmiştir?","a":"Mekke","o":["Mekke","Medine","Tâif","Hayber"]},{"q":"“Mürselât” sözü ne demektir?","a":"Gönderilenler","o":["Gönderilenler","Haber","Ayırım","Nimet"]},{"q":"“Elbette size va’d olunan şey muhakkak meydana gelecektir.” sözü kaçıncı ayettedir?","a":"7. ayet","o":["5. ayet","7. ayet","13. ayet","16. ayet"]},{"q":"29. ayetin tek kelimelik özü nedir?","a":"Çağrı","o":["Çağrı","Gölge","Çare","Söz"]},{"q":"Kitaba göre Mürselât’ın ana konusu nedir?","a":"Vaadi ciddiye almak, delilden ders almak, takvayı seçmek","o":["Vaadi ciddiye almak, delilden ders almak, takvayı seçmek","Haberi ciddiye almak, nimeti görmek, güne hazırlanmak","Yalnızca kıyametin vaktini hesaplamak","Şükür ve sabır arasındaki denge"]},{"q":"Mushaf’ta Mürselât’ın komşuları hangi surelerdir?","a":"İnsan ile Nebe’","o":["İnsan ile Nebe’","Nebe’ ile Nâziât","Kıyâme ile İnsan","Nâziât ile Abese"]}],"portre":{"baslik":"Vaadi ciddiye alır · Delilden ders alır · Takvayı seçer","giris":"Mürselât elli ayette insanı söz verilen günü ciddiye almaktan takvayı seçmeye uzanan bir yola çağırır: İlk on beş ayet gönderilenlere, esenlere, yayanlara, ayıranlara ve bırakanlara yemin eder, söz verilenin gerçek olduğunu bildirir ve ayırım gününün vaktinin belirlendiğini söyler. Sonraki on üç ayet önceki ve sonraki topluluklara, değersiz görülen bir sudan yaratılan insana, yeryüzüne, dağlara ve tatlı suya delil ve nimet olarak bakmayı ister. Son yirmi iki ayet yalan sayılana çağrıyı, takva sahiplerine müjdeyi, rükû çağrısını ve ellinci ayetteki son soruyu getirir; nakarat bu yolun on durağında tekrar eder. Bu portre aynı sırayı bugüne çevirir. Mürselât’ı anlayarak okuyan insan vaadi ciddiye alır: hatırlatmayı dinler ve yarına hazırlanır; delilden ders alır: ibret alır, kendi başlangıcını düşünür, yeryüzünü ve ölçüyü nimet olarak görür; takvayı seçer: iyilik eder ve boyun eğer. Ders başkalarını “yalanlayan” diye yargılamak değil, insanın kendi tutumuna dönmesidir.","bolumler":[{"ad":"VAADİ CİDDİYE ALIR","alt":"Vaat · Ayet 1-15"},{"ad":"DELİLDEN DERS ALIR","alt":"Delil · Ayet 16-28"},{"ad":"TAKVAYI SEÇER","alt":"Karşılık · Ayet 29-50"}],"oz":[{"b":"VAADİ CİDDİYE ALIR","ad":"Söz verilen günün gerçek olduğunu bilir.","kisa":"Yedinci ayet yeminin cevabını verir: size söz verilen mutlaka gerçekleşecektir. Hicr suresi ve Mü’min suresi de bu gerçeği hatırlatır. Kitap bu vaadin vaktini söylemez, hiçbir olayı onun gerçekleşmesi saymaz ve belirtileri tasvir etmez; vaat ciddiye alınır, korku aracı yapılmaz .","hayat":["Söz verilen günü sakin bir bilgi olarak hatırlar; bu hatırlayış onu korkutmaz, hazırlatır.","Kendi verdiği sözü de ciddiye alır ve geciktirmez."],"zit":"Vaadi hafife almak; ya da vaadi bir korku aracına çevirmek.","sor":"Bugün söz verilen günü sakin bir ciddiyetle hatırladım mı?","dene":"Bugün Mürselât 77:7’yi anlamını düşünerek oku ve verdiğin bir sözü yerine getir.","dayanak":"Mürselât 77:7; Hicr 15:85; Mü’min 40:59"},{"b":"VAADİ CİDDİYE ALIR","ad":"Hatırlatmayı ve uyarıyı dinler; duyduğu habere acele hüküm vermez, araştırır.","kisa":"Beşinci ve altıncı ayetler hatırlatmayı ve uyarıyı anar; “özür ya da uyarı” sözü için yorumlar vardır . Hucurât suresi haberi araştırmayı, İsrâ suresi bilmediğin şeyin ardına düşmemeyi öğütler. Hatırlatma baskı değil, bir lütuf olarak okunur . Uyarı sende sürekli bir kaygıya dönüşüyorsa bunu yalnız taşımazsın.","hayat":["Bir uyarıyı savunmaya geçmeden dinler, sonra düşünür.","Duyduğu habere hemen inanmaz ya da yaymaz; önce araştırır."],"zit":"Her habere hemen inanmak; ya da hiçbir uyarıyı dinlememek.","sor":"Bugün hangi haberi araştırdım, hangi uyarıyı dinledim?","dene":"Bugün Hucurât 49:6’yı oku ve paylaşmadan önce duyduğun bir haberi doğrula.","dayanak":"Mürselât 77:5-6; Hucurât 49:6; İsrâ 17:36"},{"b":"VAADİ CİDDİYE ALIR","ad":"Bugünden yarına hazırlanır.","kisa":"On ikinci ayet “hangi güne ertelendi?” diye sorar, on üçüncü ayet “ayırım gününe” diye cevaplar; bu kitap ayırım gününün belirtilerini tasvir etmez. Haşr suresi herkesin yarın için ne gönderdiğine bakmasını, Tâhâ suresi herkesin yaptığının karşılığını görmesini söyler. Hazırlık kaygıyla değil, küçük ve düzenli adımlarla yapılır .","hayat":["Yarın için küçük bir hazırlık yapar: bir iş, bir özür, bir iyilik.","Ertelediği hayırlı işi bugüne alır."],"zit":"Her şeyi yarına bırakmak; ya da yarını düşünüp bugünü kaygıyla geçirmek.","sor":"Bugün yarın için hangi küçük adımı attım?","dene":"Bugün Haşr 59:18’i oku ve yarın için tek bir hazırlık yap.","dayanak":"Mürselât 77:12-14; Haşr 59:18; Tâhâ 20:15"},{"b":"DELİLDEN DERS ALIR","ad":"Önceki toplulukların akıbetine bakıp ibret alır.","kisa":"On altıncı ve on yedinci ayetler önceki ve sonraki topluluklara bakmayı bir ibret çağrısı olarak sunar; bu kitap helak sahnesi anlatmaz. Rûm suresi yeryüzünde gezip bakmayı, Mü’min suresi önceki topluluklara bakmayı, Yûsuf suresi kıssalarda akıl sahipleri için ibret bulunduğunu söyler. “Evvelîn” ve “âhirîn” sözlerinin kimleri kapsadığı için yorumlar vardır . İbret almak başkasını yargılamak değil, kendi yoluna bakmaktır; kimse bu ayetlerle yaftalanmaz (Hucurât, 49:11) .","hayat":["Bir olayın sonucuna bakıp kendi alışkanlığı için ders çıkarır.","Başkalarının deneyiminden öğrenir; kimseyle alay etmez."],"zit":"Geçmişe hiç bakmamak; ya da geçmişi başkalarını suçlamak için kullanmak.","sor":"Bugün hangi örnekten kendime ders aldım?","dene":"Bugün Rûm 30:42’yi oku ve geçmişte yaşanmış bir olaydan kendi alışkanlığın için tek bir ders yaz.","dayanak":"Mürselât 77:16-17; Rûm 30:42; Mü’min 40:21"},{"b":"DELİLDEN DERS ALIR","ad":"Kendi yaratılışının başlangıcını düşünür ve mütevazı olur.","kisa":"Yirminci ayetten yirmi ikinci ayete kadar insanın değersiz görülen bir sudan yaratıldığı ve bilinen bir süreye kadar güvenli bir yerde tutulduğu hatırlatılır. İnsan suresi ve Târık suresi insanın başlangıcını düşünmeyi ister. Bu ayetler için bilimsel bir eşleştirme yapılmaz ; ders tevazudur: insan kendi gücüyle var olmamıştır . Başlangıcı küçük görmek kimseyi küçük düşürmek için değildir.","hayat":["Başarısında kapılmadan hatırlar: bir başlangıcı vardı ve bir ölçüyle yaratıldı.","Başkasını geçmişiyle ya da kökeniyle küçümsemez."],"zit":"Kendini kendinden var saymak; ya da başlangıcını küçük görüp kendini değersiz saymak.","sor":"Bugün hangi başarımda mütevazı kaldım?","dene":"Bugün Târık 86:5-7’yi oku ve bir başarını Allah’ın verdiği imkânla birlikte düşün.","dayanak":"Mürselât 77:20-22; Târık 86:5-7; İnsan 76:1-2"},{"b":"DELİLDEN DERS ALIR","ad":"Yeryüzünü, dağları ve tatlı suyu nimet olarak görür.","kisa":"Yirmi beşinci ayetten yirmi yedinci ayete kadar yeryüzü, sağlam dağlar ve tatlı su bir soruyla nimet olarak anılır. Nebe’ suresi yeryüzünü ve dağları, Nahl suresi suyu ve bitkileri aynı çerçevede sayar. Meal parantezleri ve “kifâten” için yorumlar vardır ; ayetler bir yer bilimi ya da su bilimi açıklaması değildir. Suya ya da toprağa ulaşamayan kimse suçlanmaz.","hayat":["Bir bardak suyu içerken nimeti hatırlar ve israf etmez.","Suyun ve toprağın korunmasına küçük bir katkı verir."],"zit":"Nimeti sıradanlaştırıp görmemek; ya da nimeti israf etmek.","sor":"Bugün hangi nimeti fark ettim?","dene":"Bugün Nahl 16:10-11’i oku ve bir gün boyunca suyu israf etmemeye çalış.","dayanak":"Mürselât 77:25-27; Nebe’ 78:6-7; Nahl 16:10-11"},{"b":"DELİLDEN DERS ALIR","ad":"Her şeyin bir ölçüyle yaratıldığını görür ve şükreder.","kisa":"Yirmi ikinci ve yirmi üçüncü ayetler bilinen bir süreyi ve ölçüyü anar; “fe kaderna” için “ölçtük” ya da “güç yetirdik” anlayışları vardır . Kamer suresi her şeyin bir ölçüyle yaratıldığını, İbrâhîm suresi nimetlerin sayılamayacağını bildirir. Şükür yalnız söz değil, nimeti yerinde kullanmaktır . Nimeti az olan kimse “şükretmiyorsun” diye suçlanmaz.","hayat":["Gün sonunda üç nimeti ismen sayar ve teşekkür eder.","Sahip olduğunu ölçülü kullanır; fazlasını paylaşır."],"zit":"Eksiğe bakıp nimeti görmemek; ya da şükrü yalnız mutlu olunca hatırlamak.","sor":"Bugün hangi nimeti ölçüsüyle gördüm?","dene":"Bugün İbrâhîm 14:34’ü oku ve üç nimeti yazıp teşekkür et.","dayanak":"Mürselât 77:22-23; Kamer 54:49; İbrâhîm 14:34"},{"b":"TAKVAYI SEÇER","ad":"Takvayı azık bilir.","kisa":"Kırk birinci ayet takva sahiplerinin gölgeler, pınarlar ve istedikleri meyveler içinde olduğunu bildirir; kitap bu müjdeyi ayetin sözüyle verir, tasvir kurmaz. Bakara suresi azığın en hayırlısının takva olduğunu, Âl-i İmrân suresi takva sahiplerinin özelliklerini sayar. Takva Allah’a saygıyla sakınmaktır; kimsenin takvası ölçülmez ve kimse “takvasız” diye yaftalanmaz .","hayat":["Bir işe başlarken “Bu Allah’a saygıya uygun mu?” diye sorar.","Zor bir seçimde kolay olanı değil, doğru olanı seçmeye çalışır."],"zit":"Takvayı gösteriş saymak; ya da takvayı başkasını ölçmek için kullanmak.","sor":"Bugün hangi seçimimde takvayı gözettim?","dene":"Bugün Bakara 2:197’yi oku ve gün içinde bir seçimini takvaya göre yap.","dayanak":"Mürselât 77:41; Bakara 2:197; Âl-i İmrân 3:133-134"},{"b":"TAKVAYI SEÇER","ad":"İyilik eder; karşılığı Allah’tan bilir.","kisa":"Kırk dördüncü ayet iyilik edenlere böyle karşılık verildiğini bildirir. Rahmân suresi güzel davranmanın karşılığının güzellik olduğunu, Nahl suresi Allah’ın takva sahipleriyle ve iyilik edenlerle beraber olduğunu söyler. İyilik karşılık beklemek için değil, karşılığın Allah’tan olduğunu bilerek yapılır . İyilik edemeyen ya da yorulan kimse suçlanmaz.","hayat":["Kimse görmese de küçük bir iyilik yapar.","Yaptığı iyiliği başa kakmaz; karşılığı Allah’tan bilir."],"zit":"İyiliği gösteriş için yapmak; ya da karşılık görmeyince iyiliği bırakmak.","sor":"Bugün kime hangi iyiliği yaptım?","dene":"Bugün Rahmân 55:60’ı oku ve birine karşılık beklemeden bir iyilik yap.","dayanak":"Mürselât 77:44; Rahmân 55:60; Nahl 16:128"},{"b":"TAKVAYI SEÇER","ad":"Rükûya çağrıldığında boyun eğer; sözün en güzeline, Kur’an’a bakar.","kisa":"Kırk sekizinci ayet rükû çağrısını anar; rükû namazdaki eğilme ya da genel olarak boyun eğme diye anlaşılır . Bakara suresi rükû edenlerle birlikte rükû etmeyi söyler. Sure ellinci ayetteki son soruyla kapanır; Zümer suresi sözün en güzelinin Kur’an olduğunu bildirir . Çağrı bir davettir: kimse “rükû etmeyen” diye damgalanmaz, kimsenin imanı ölçülmez; soru okura bir düşünme daveti olarak sorulur.","hayat":["İyiliğe ve ibadete çağrıldığında tereddüt etmeden zaman ayırır.","Bir söze güvenmeden önce “Bu sözün kaynağı ne?” diye sorar ve Kur’an’a döner."],"zit":"Çağrıya kulak tıkamak; ya da boyun eğmeyi başkasını yargılamak için kullanmak.","sor":"Bugün hangi söze güvendim ve neye boyun eğdim?","dene":"Bugün Bakara 2:43’ü oku ve Zümer 39:23’ü anlamını düşünerek bir kez daha oku.","dayanak":"Mürselât 77:48; 77:50; Bakara 2:43; Zümer 39:23"}]},"ses":{"bas":[0.0,3.06,6.04,9.46,12.33,15.26,17.79,22.07,25.34,29.28,32.02,34.71,37.58,39.59,44.55,50.53,55.15,60.58,65.78,72.05,80.77,86.46,91.58,96.49,102.29,105.97,111.09,122.61,128.7,139.91,148.16,153.28,158.61,163.52,170.18,175.9,181.46,188.07,195.23,202.49,209.1,217.22,223.33,232.89,238.74,245.22,253.27,259.59,266.15,272.94],"son":283.05},"tecvid":[[[["وَ",null],["ٱ","ham_wasl"],["لْمُرْسَلَ",null],["ٰ","madda_normal"],["تِ",null]],[["عُرْفًا",null]]],[[["فَ",null],["ٱ","ham_wasl"],["لْعَ",null],["ٰ","madda_normal"],["صِفَ",null],["ٰ","madda_normal"],["تِ",null]],[["عَصْفًا",null]]],[[["وَ",null],["ٱ","ham_wasl"],["ل","laam_shamsiyah"],["نّ","ghunnah"],["َ",null],["ٰ","madda_normal"],["شِر",null],["َٰ","madda_normal"],["تِ",null]],[["نَشْرًا",null]]],[[["فَ",null],["ٱ","ham_wasl"],["لْفَ",null],["ٰ","madda_normal"],["رِقَ",null],["ٰ","madda_normal"],["تِ",null]],[["فَرْقًا",null]]],[[["فَ",null],["ٱ","ham_wasl"],["لْمُلْقِيَ",null],["ٰ","madda_normal"],["تِ",null]],[["ذِكْرًا",null]]],[[["عُذْرًا",null]],[["أَوْ",null]],[["نُذْرًا",null]]],[[["إِ",null],["نّ","ghunnah"],["َمَا",null]],[["تُوعَدُونَ",null]],[["لَو",null],["َٰ","madda_normal"],["قِعٌ",null]]],[[["فَإِذَا",null]],[["ٱ","ham_wasl"],["ل","laam_shamsiyah"],["نّ","ghunnah"],["ُجُومُ",null]],[["طُمِسَتْ",null]]],[[["وَإِذَا",null]],[["ٱ","ham_wasl"],["ل","laam_shamsiyah"],["سَّم",null],["َا","madda_obligatory"],["ٓءُ",null]],[["فُرِجَتْ",null]]],[[["وَإِذَا",null]],[["ٱ","ham_wasl"],["لْجِبَالُ",null]],[["نُسِفَتْ",null]]],[[["وَإِذَا",null]],[["ٱ","ham_wasl"],["ل","laam_shamsiyah"],["رُّسُلُ",null]],[["أُقِّتَتْ",null]]],[[["لِأَىِّ",null]],[["يَوْمٍ",null]],[["أُجِّلَتْ",null]]],[[["لِيَوْمِ"